---
import { ICON_PATHS } from '@/lib/icon-paths';

interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'h-5 w-5' } = Astro.props;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICON_PATHS[name] ?? ''}
/>
