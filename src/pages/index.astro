---
// Start page: pick a quiz. Quizzes that are planned but not built yet are
// listed as "Binnenkort" so the start page already has its final shape.
import Icon from '@/components/Icon.astro';
import { T } from '@/i18n/nl';
import Base from '@/layouts/Base.astro';

const quizzes = [
  { href: '/vlaggen/', icon: 'flag', ...T.quizzes.vlaggen, ready: true },
  { href: '/hoofdsteden/', icon: 'landmark', ...T.quizzes.hoofdsteden, ready: true },
  { href: '/landen/', icon: 'map', ...T.quizzes.landen, ready: true },
  { href: '/aardrijkskunde/', icon: 'mountain', ...T.quizzes.aardrijkskunde, ready: true },
  { href: '/spreuken/', icon: 'quote', ...T.quizzes.spreuken, ready: false },
];
const ready = quizzes.filter((quiz) => quiz.ready);
const soon = quizzes.filter((quiz) => !quiz.ready);
---

<Base title={T.site.title}>
  <div class="flex min-h-dvh flex-col">
    <header class="border-b border-slate-200 bg-white">
      {/* As tall as the header of a quiz (py-3 around an h-11 row), so the pages line up. */}
      <div class="max-w-page mx-auto flex items-center gap-3 px-4 py-3">
        <h1 class="flex h-11 shrink-0 items-center text-2xl font-bold tracking-tight">
          {T.site.title}
        </h1>
        <p class="truncate text-slate-500">{T.site.tagline}</p>
      </div>
    </header>

    <main class="max-w-page mx-auto grid w-full gap-4 p-4 md:grid-cols-2">
      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <h2 class="flex min-h-10 items-center border-b border-slate-200 bg-slate-100 px-4 text-sm font-semibold text-slate-600">
          {T.site.play}
        </h2>
        <ul class="divide-y divide-slate-200">
          {ready.map((quiz) => (
            <li>
              <a href={quiz.href} class="flex items-center gap-3 px-4 py-4 hover:bg-slate-50">
                <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-800 text-white">
                  <Icon name={quiz.icon} class="h-5 w-5" />
                </span>
                <span class="flex flex-1 flex-col">
                  <span class="text-lg font-semibold">{quiz.title}</span>
                  <span class="text-sm text-slate-500">{quiz.description}</span>
                </span>
                <Icon name="arrow-right" class="h-5 w-5 text-slate-400" />
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="overflow-hidden rounded-xl border border-slate-200 bg-white">
        <h2 class="flex min-h-10 items-center border-b border-slate-200 bg-slate-100 px-4 text-sm font-semibold text-slate-600">
          {T.site.soon}
        </h2>
        <ul class="divide-y divide-slate-200">
          {soon.map((quiz) => (
            <li class="flex items-center gap-3 px-4 py-3.5 text-slate-400">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-slate-100">
                <Icon name={quiz.icon} class="h-5 w-5" />
              </span>
              <span class="flex flex-1 flex-col">
                <span class="font-semibold">{quiz.title}</span>
                <span class="text-sm">{quiz.description}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    </main>

    <footer class="mt-auto flex justify-center px-4 pt-8 pb-[max(2rem,env(safe-area-inset-bottom))]">
      <a
        href="https://stroel.dev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={T.site.byStroel}
        class="rounded-lg p-2 opacity-70 transition-opacity hover:opacity-100"
      >
        <img src="https://stroel.dev/dark-landscape.svg" alt="" class="h-20 w-auto" />
      </a>
    </footer>
  </div>
</Base>
