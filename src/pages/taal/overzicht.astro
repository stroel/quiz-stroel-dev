---
// Every question with its answers, per series: to read through before playing.
import Panel from '@/components/Panel.astro';
import { T } from '@/i18n/nl';
import Overview from '@/layouts/Overview.astro';
import { ALL_SERIES, questionsIn } from '@/lib/word-pool';

const sections = ALL_SERIES.map((series) => ({
  title: T.language.series[series],
  questions: questionsIn(series),
})).filter((section) => section.questions.length > 0);
---

<Overview quizTitle={T.quizzes.taal.title} quizHref="/taal/">
  {sections.map((section) => (
    <Panel collapsible title={section.title} aside={String(section.questions.length)}>
      <ul class="divide-y divide-slate-200 md:-mb-px md:grid md:grid-cols-2 md:divide-y-0 lg:grid-cols-3 xl:grid-cols-4">
        {section.questions.map((word) => (
          <li class="flex flex-col gap-0.5 px-4 py-2.5 md:border-b md:border-slate-200">
            <span class="flex flex-wrap items-baseline justify-between gap-x-3">
              <span lang={word.lang} class="text-slate-500">
                {word.prompt}
              </span>
              <span class="font-semibold">{word.answers[0]}</span>
            </span>
            {word.answers.length > 1 && (
              <span class="text-sm text-slate-500">
                {T.overview.alsoAccepted(word.answers.slice(1).join(', '))}
              </span>
            )}
            {word.note && <span class="text-sm text-slate-500">{word.note}</span>}
          </li>
        ))}
      </ul>
    </Panel>
  ))}
</Overview>
