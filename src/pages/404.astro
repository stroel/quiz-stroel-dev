---
// Shared STROEL 404 page.
//
// Self-contained document (its own <html>) on purpose: it carries its own
// light/dark theming, independent of any app layout. Drop in as
// `src/pages/404.astro`. Adjust the stylesheet import below to the project's
// global CSS.
//
// Requires class-based dark mode. Tailwind v4 has no tailwind.config — add this
// line to the global stylesheet that holds `@import "tailwindcss";`:
//
//   @custom-variant dark (&:where(.dark, .dark *));
//
// Favicon + logos are served from stroel.dev (centralized — update once, every
// project inherits); dark-* is the dark logo for light backgrounds, light-* the
// white one for dark. The home-icon SVG is inlined Lucide (`house`) so this page
// stays portable to projects without an Icon component.
//
// Translated to Dutch: the 404 follows the project's UI language.
//
// `min-h-dvh`, not `min-h-screen`: on mobile 100vh is the viewport with the
// address bar retracted, so a centred page would scroll for no reason.
import '@/styles/global.css';
---

<!doctype html>
<html lang="nl" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="https://stroel.dev/favicon.svg" />
    <title>404 — Pagina niet gevonden · STROEL</title>

    <script is:inline>
      // Set theme BEFORE paint to avoid a flash. Defaults to system, remembers the choice.
      (function () {
        try {
          const saved = localStorage.getItem('stroel-theme');
          const dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch {
          /* localStorage/matchMedia unavailable — fall back to light */
        }
      })();
    </script>
    <style is:global>
      html {
        -webkit-font-smoothing: antialiased;
      }
      ::selection {
        background: #e2e8f0;
        color: #0f172a;
      }
      .dark ::selection {
        background: #334155;
        color: #f1f5f9;
      }
    </style>
  </head>

  <body class="min-h-full font-sans bg-slate-50 text-slate-900 transition-colors duration-300 dark:bg-slate-900 dark:text-slate-100">
    <main class="relative mx-auto flex min-h-dvh max-w-xl flex-col items-center justify-center px-6 py-10 text-center">
      <div class="select-none text-[150px] font-bold leading-none tracking-tighter text-slate-200 dark:text-slate-700 sm:text-[210px]">
        404
      </div>

      <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-900 dark:text-slate-50 sm:text-3xl">
        Hier is niets te raden.
      </h1>
      <p class="mt-3 max-w-md text-base leading-relaxed text-slate-500 dark:text-slate-400">
        Deze pagina bestaat niet, of niet meer. Misschien is ze verhuisd, of was ze er nooit.
      </p>

      <a
        href="/"
        class="mt-8 inline-flex h-11 items-center justify-center gap-2 whitespace-nowrap rounded-md border border-transparent bg-slate-900 px-5 text-base font-medium text-white transition-colors hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-700 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 dark:focus-visible:ring-slate-400 dark:focus-visible:ring-offset-slate-900"
      >
        <svg
          class="h-4 w-4"
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8" />
          <path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
        </svg>
        Terug naar de startpagina
      </a>

      <a
        href="https://stroel.dev"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Naar stroel.dev (opent in een nieuw tabblad)"
        class="group mt-10 rounded-lg p-2 opacity-80 transition-all duration-200 hover:scale-[1.03] hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-50 dark:focus-visible:ring-slate-500 dark:focus-visible:ring-offset-slate-900"
      >
        <img
          src="https://stroel.dev/dark-landscape.svg"
          alt="STROEL — webontwikkeling"
          class="block h-20 w-auto dark:hidden"
        />
        <img
          src="https://stroel.dev/light-landscape.svg"
          alt="STROEL — webontwikkeling"
          class="hidden h-20 w-auto dark:block"
        />
      </a>
    </main>

    <script is:inline>
      // Click anywhere (except links/buttons) to toggle light/dark; choice persists.
      document.addEventListener('click', function (e) {
        if (e.target.closest('a, button')) return;
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('stroel-theme', dark ? 'dark' : 'light');
        } catch {
          /* localStorage unavailable — ignore */
        }
      });
    </script>
  </body>
</html>
