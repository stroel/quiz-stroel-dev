---
// The map quiz is one React island. `client:only`: setup and history come from
// localStorage, which the server cannot see, so rendering it on the server would
// only produce markup that is replaced on load.
import CountryQuiz from '@/components/countries/CountryQuiz';
import { T } from '@/i18n/nl';
import Base from '@/layouts/Base.astro';
---

<Base title={`${T.quizzes.landen.title} · ${T.site.title}`}>
  <CountryQuiz client:only="react" />
</Base>
