---
// Shell for every page. Built for phones first: the viewport follows the
// keyboard (`interactive-widget`), the page may run under the notch
// (`viewport-fit`), and when added to the home screen it opens without
// browser chrome. The quiz is light only (see the quiz-design skill), so there
// is no dark-theme script.
import '@/styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Quiz" />
    <link rel="icon" type="image/svg+xml" href="https://stroel.dev/favicon.svg" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="preload" href="/fonts/lexend-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
  </head>

  <body class="min-h-dvh bg-slate-50 font-sans text-slate-900">
    <slot />
  </body>
</html>
