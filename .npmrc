# @stroel packages are served from GitHub Packages (private).
# The auth token is NOT in this file — it lives in ~/.npmrc:
#   Local dev      : NODE_AUTH_TOKEN exported in your shell profile, referenced from ~/.npmrc (see README)
#   GitHub Actions : written to ~/.npmrc from the GH_PACKAGES_TOKEN secret (see .github/workflows/)
@stroel:registry=https://npm.pkg.github.com
